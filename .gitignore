node_modules/
dist/
.superpowers/
packages/store/.pgdata/
packages/store/.pgdata.log

# Isolated workspaces for milestone branches
.worktrees/

# Generated by docs/whitepaper/build.py. The whitepaper-source branch carries
# this rule in its own docs/whitepaper/.gitignore; main has no such file, so
# without this line a `git add -A` on any branch sweeps four megabytes of
# generated PDFs and HTML into a commit. It happened once.
docs/whitepaper/build/

# The indexer's run artefacts: account lists, resume state, the page cache and
# what a run writes. All reproducible from a run, and none of it small.
packages/indexer/accounts*.txt
packages/indexer/state*.json
packages/indexer/cache/
packages/indexer/out/
packages/indexer/*.txt
packages/indexer/*.log
packages/indexer/out*/

# `compose-gate.test.ts` builds a throwaway tree here to hold its symlink rules,
# outside `src/` so no other gate's scan can see it, and removes it in a
# `finally`. Ignored so an interrupted run cannot leave a probe in `git status`.
packages/engine/.compose-gate-probe/
