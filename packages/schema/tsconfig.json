{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // Every extension the compiler admits, so a test file cannot reach dist by
  // renaming. CI proves the property after each build: no dist file matches
  // *.test.*. tsconfig.test.json resets this list to typecheck the tests.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.mts",
    "src/**/*.test.cts",
    "src/**/*.test.tsx"
  ]
}
